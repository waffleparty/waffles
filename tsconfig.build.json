{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "core/**/*.ts",
    "adapters/**/*.ts",
    "scripts/**/*.ts",
    "skills/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/testing.ts",
    "scripts/build-npm.ts",
    "node_modules",
    "dist",
    ".claude"
  ]
}
