{
  "description": "waffles: the modes, unattended runs, the plan outline's context, and the checkpoint after a push. Each hook runs adapters/command/cli.ts.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/adapters/command/cli.ts\" codex SessionStart",
            "timeout": 30,
            "additionalContextLimit": 8000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/adapters/command/cli.ts\" codex UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^request_user_input$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/adapters/command/cli.ts\" codex PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/adapters/command/cli.ts\" codex PermissionRequest",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|request_user_input)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/adapters/command/cli.ts\" codex PostToolUse",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/adapters/command/cli.ts\" codex Stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/adapters/command/cli.ts\" codex SessionEnd",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
